# Copy this to ".env" in the same folder, fill in the keys for the providers you
# actually want, then lock it down:  chmod 600 .env
#
# The server reads these at startup. A provider with no key is just skipped, so
# you don't need to fill in all of them. Nothing here ever goes in the code.

# --- Kimi (Moonshot) ---  https://platform.moonshot.ai
# This one key powers BOTH the `kimi` (K2.6, general) and `kimi-code` (K2.7 Code)
# providers — they share the same Moonshot account.
KIMI_API_KEY=

# --- DeepSeek ---  https://platform.deepseek.com
DEEPSEEK_API_KEY=

# --- MiMo (Xiaomi) ---  https://platform.xiaomimimo.com
# The public endpoint (https://api.xiaomimimo.com/v1) is baked in, so a key is all
# you need. Override MIMO_BASE_URL only for a private deployment.
# MIMO_API_KEY=
# MIMO_BASE_URL=https://your-mimo-endpoint/v1

# --- optional overrides (defaults are fine for most people) ---
# KIMI_MODEL=kimi-k2.6
# KIMI_CODE_MODEL=kimi-k2.7-code
# DEEPSEEK_MODEL=deepseek-v4-pro
# MIMO_MODEL=mimo-v2.5-pro
# DEEPSEEK_TIMEOUT_MS=1800000
