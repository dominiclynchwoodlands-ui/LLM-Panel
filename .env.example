# Copy this to ".env" in the same folder, fill in the keys for the providers you
# actually want, then lock it down:  chmod 600 .env
#
# The server reads these at startup. A provider with no key is just skipped, so
# you don't need to fill in all of them. Nothing here ever goes in the code.

# --- Kimi (Moonshot) ---  https://platform.moonshot.ai
KIMI_API_KEY=

# --- DeepSeek ---  https://platform.deepseek.com
DEEPSEEK_API_KEY=

# --- MiMo (Xiaomi) ---
# No public endpoint is baked in, so MiMo needs BOTH a key and a base URL.
# MIMO_API_KEY=
# MIMO_BASE_URL=https://your-mimo-endpoint/v1

# --- optional overrides (defaults are fine for most people) ---
# KIMI_MODEL=kimi-k2.6
# DEEPSEEK_MODEL=deepseek-v4-pro
# DEEPSEEK_TIMEOUT_MS=1800000
